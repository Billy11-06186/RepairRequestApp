<Window x:Class="RepairRequestApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="641" Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True">

    <Window.Background>
        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
            <GradientStop Color="#1A2980" Offset="0"/>
            <GradientStop Color="#26D0CE" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Button x:Name="btnClose" 
                Content="✕" 
                Width="35" Height="35"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top"
                Margin="0,10,15,0"
                Background="Transparent"
                Foreground="White"
                FontSize="18"
                FontWeight="Bold"
                BorderThickness="0"
                Cursor="Hand"
                Click="BtnExit_Click"/>

        <Border Background="White" 
                CornerRadius="20" 
                Margin="20" 
                Padding="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" 
                                  ShadowDepth="5" 
                                  Opacity="0.3"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="🔧" 
                               FontSize="48" 
                               HorizontalAlignment="Center"
                               Foreground="#1A2980"/>
                    <TextBlock Text="Система учёта заявок" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="#1A2980" 
                               HorizontalAlignment="Center"
                               Margin="0,10,0,5"/>
                    <TextBlock Text="на ремонт оборудования" 
                               FontSize="14" 
                               Foreground="#7F8C8D" 
                               HorizontalAlignment="Center"/>
                    <Border Height="3" 
                            Width="80" 
                            Background="#FF8C42" 
                            CornerRadius="5" 
                            Margin="0,15,0,0"
                            HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <TextBlock Text="ЛОГИН" 
                               FontSize="12" 
                               FontWeight="Bold" 
                               Foreground="#34495E"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="txtLogin" 
                             Height="50" 
                             FontSize="14"
                             Padding="15,0,15,0"
                             VerticalContentAlignment="Center"
                             Background="#F8FAFC"
                             BorderBrush="#E2E8F0"
                             BorderThickness="1"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,15">
                    <TextBlock Text="ПАРОЛЬ" 
                               FontSize="12" 
                               FontWeight="Bold" 
                               Foreground="#34495E"
                               Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtPassword" 
                                 Height="50" 
                                 FontSize="14"
                                 Padding="15,0,15,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F8FAFC"
                                 BorderBrush="#E2E8F0"
                                 BorderThickness="1"/>
                </StackPanel>

                <Border Grid.Row="3" 
                        Background="#F0F7FF" 
                        CornerRadius="10" 
                        Padding="15" 
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Тестовые данные для входа" 
                                   FontSize="12" 
                                   FontWeight="Bold" 
                                   Foreground="#1A2980"
                                   Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                       Text="Логин:" 
                                       FontSize="12" 
                                       Foreground="#7F8C8D"
                                       Margin="0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                       Text="user" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="#FF8C42"
                                       Margin="10,5,0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" 
                                       Text="Пароль:" 
                                       FontSize="12" 
                                       Foreground="#7F8C8D"
                                       Margin="0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" 
                                       Text="12345" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="#FF8C42"
                                       Margin="10,5,0,5"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Button x:Name="btnLogin" 
                        Grid.Row="4"
                        Content="ВОЙТИ В СИСТЕМУ" 
                        Height="55" 
                        Background="#FF8C42" 
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        Cursor="Hand"
                        Click="BtnLogin_Click"
                        Margin="0,10,0,10">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FF8C42"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E67E22"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#D35400"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Border x:Name="errorBorder" 
                        Grid.Row="5"
                        Background="#FEF3F2" 
                        CornerRadius="8" 
                        Padding="12" 
                        Margin="0,10,0,0"
                        Visibility="Collapsed"
                        BorderBrush="#FCA5A5"
                        BorderThickness="1">
                    <TextBlock x:Name="txtError" 
                               Text="" 
                               Foreground="#DC2626" 
                               FontSize="12" 
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>